# Copy to .env and fill in. Everything here is OPTIONAL except the SEC user
# agent, which you should personalize — the SEC blocks generic user agents.

# --- Recommended -----------------------------------------------------------
# SEC requires a real contact string. Replace with your name and email.
SEC_USER_AGENT=YourName/Apollo (your.email@example.com)

# --- Alpaca news websocket (the only real-time push source) ----------------
# Free at https://alpaca.markets — paper trading account is enough.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Optional free-tier APIs; collectors self-disable when these are blank --
# https://cryptopanic.com/developers/api/   (crypto news + community votes)
CRYPTOPANIC_TOKEN=
# https://finnhub.io/register               (60 calls/min free)
FINNHUB_KEY=
# https://newsapi.org/register              (100 requests/day free)
NEWSAPI_KEY=

# --- Paths -----------------------------------------------------------------
# APOLLO_DB=apollo.db
